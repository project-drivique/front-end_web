{
  "roles": {
    "user": "usuario",
    "admin": "administrador",
    "branchManager": "encargado_sucursal"
  },
  "permissions": {
    "adminPanel": "panel_administracion",
    "branchPanel": "panel_sucursal"
  },
  "destinations": {
    "usuario": "/home",
    "administrador": "/admin",
    "encargado_sucursal": "/encargado"
  },
  "security": {
    "maxLoginAttempts": 3,
    "lockDurationMinutes": 5
  },
  "audit": {
    "maxRecords": 100
  },
  "dashboardModules": {
    "administrador": ["vehicles", "users", "reservations", "contracts", "cities", "branches", "audit"],
    "encargado_sucursal": ["vehicles", "reservations", "contracts"]
  },
  "dashboardNavigation": {
    "administrador": [
      { "key": "dashboard", "route": "/admin" },
      { "key": "vehicles", "route": "/admin/vehicles" },
      { "key": "users", "route": "/admin/users" },
      { "key": "reservations", "route": "/admin/reservations" },
      { "key": "contracts", "route": "/admin/contracts" },
      { "key": "cities", "route": "/admin/cities" },
      { "key": "branches", "route": "/admin/branches" },
      { "key": "audit", "route": "/admin/audit" }
    ],
    "encargado_sucursal": [
      { "key": "dashboard", "route": "/encargado" },
      { "key": "vehicles", "route": "/encargado/vehicles" },
      { "key": "reservations", "route": "/encargado/reservations" },
      { "key": "contracts", "route": "/encargado/contracts" }
    ]
  }
}
